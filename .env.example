# Server-side only. Generate a production key in your data.gov.in account.
DATA_GOV_IN_API_KEY=

# Provision through the Vercel Neon Marketplace integration. Never expose in browser code.
DATABASE_URL=

# Vercel Cron sends this as a bearer token to the source-freshness endpoint.
CRON_SECRET=

# Provision together through the Vercel Clerk Marketplace integration.
# The publishable key is intentionally browser-safe; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
